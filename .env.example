# This is a template, copy it to a file `.env`

# Django Settings
SECRET_KEY= '' # From settings.py
DEBUG=True # Either True (1) or False (0) for debug, when deploying ensure its false.
# Seperate Hosts with spaces
ALLOWED_HOSTS=localhost 127.0.0.1 [::1] 0.0.0.0 # [::1] for Ipv6 support.

# Database Settings (Postgresql)
# Note POSTGRES_HOST must match the service name in docker-compose.yml
POSTGRES_DB=bristol_food_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

GOADDRESS_API_KEY=

# Stripe API Keys
STRIPE_PUBLIC_KEY = 
STRIPE_SECRET_KEY =

# Email Settings
EMAIL_HOST_USER=your_email@gmail.com
# Steps: Go to your google account -> Security -> 2 Step-Verification (Turn it on) -> Visit https://myaccount.google.com/apppasswords -> create it.
EMAIL_HOST_PASSWORD=your_16_character_app_password_here 

# AI integration settings (DESD -> AI inference service)
AI_INFERENCE_BASE_URL=http://ai-service:8001
# Current Django AI scaffold Task 2 endpoint:
AI_INFERENCE_PREDICT_PATH=/api/task2/predict/
AI_INFERENCE_TIMEOUT_SECONDS=15
AI_EXPORT_DIR=/app/media/ai_exports

# AI lifecycle settings (DESD mirrors state, AAI owns activation authority)
AI_LIFECYCLE_SYNC_ENABLED=1
AI_LIFECYCLE_ALLOW_LOCAL_FALLBACK=1
AI_LIFECYCLE_BASE_URL=http://ai-service:8001
AI_LIFECYCLE_TIMEOUT_SECONDS=5
AI_MODEL_LIST_PATH=/api/task3/models/
AI_MODEL_UPLOAD_PATH=/api/task3/models/upload/
AI_MODEL_ACTIVATE_PATH=/api/task3/models/activate/
AI_MODEL_ROLLBACK_PATH=/api/task3/models/rollback/

# Optional future wiring (when DESD integrates Task 1 and Task 4 service calls)
AI_RECOMMEND_BASE_URL=http://ai-service:8001
AI_RECOMMEND_PATH=/api/task1/recommend/
AI_EXPLAIN_BASE_URL=http://ai-service:8001
AI_EXPLAIN_PATH=/api/task4/explain/

# Optional: AI microservice container image and runtime configuration
# Start with: docker compose --profile ai up -d
# Local-only flow: keep this tag and build locally with ./setup_ai.sh (no remote push required)
AI_SERVICE_IMAGE=desd-ai-service:latest
AI_SERVICE_MODEL_PATH=/models/fresh_rotten_resnet50.pth
AI_SERVICE_PREDICT_ROUTE=/predict
